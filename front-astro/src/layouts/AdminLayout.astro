---
// Layout del panel de administración. Es independiente del de la tienda
// (no lleva buscador ni carrito). La protección real está en el backend;
// el componente React de cada página además revisa que seas admin.
import '../styles/global.css'
import '../styles/admin.css'

interface Props {
    title: string
    seccion: string
}

const { title, seccion } = Astro.props

// "listo: false" = sección de una etapa siguiente; se muestra como "Pronto".
const secciones = [
    { id: 'resumen', href: '/admin', label: 'Resumen', listo: true,
      icono: 'M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z' },
    { id: 'productos', href: '/admin/productos', label: 'Productos', listo: true,
      icono: 'M12 2 3 7v10l9 5 9-5V7l-9-5zm0 2.3L18.7 8 12 11.7 5.3 8 12 4.3zM5 9.7l6 3.3v6.6l-6-3.3V9.7zm8 9.9V13l6-3.3v6.6l-6 3.3z' },
    { id: 'pedidos', href: '/admin/pedidos', label: 'Pedidos', listo: true,
      icono: 'M7 4h10l1 3h3v2h-1.2l-1.6 11H5.8L4.2 9H3V7h3l1-3zm.6 3h8.8l-.4-1H8l-.4 1zM6.2 9l1.3 9h9l1.3-9H6.2z' },
    { id: 'pagos', href: '/admin/pagos', label: 'Pagos', listo: true,
      icono: 'M2 6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6zm2 0v2h16V6H4zm0 5v7h16v-7H4zm2 4h5v2H6v-2z' },
    { id: 'clientes', href: '/admin/clientes', label: 'Clientes', listo: true,
      icono: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0-6a2 2 0 1 1 0 4 2 2 0 0 1 0-4zm-8 14c0-3.3 3.6-6 8-6s8 2.7 8 6v1H4v-1zm2.2-1h11.6c-.6-1.8-3-3-5.8-3s-5.2 1.2-5.8 3z' },
]
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex" />
        <title>{title} | Panel ALMĀS</title>
    </head>

    <body class="admin-body">
        <div class="admin-shell">
            <aside class="admin-sidebar">
                <a class="admin-marca" href="/admin">
                    ALMĀS
                    <span>Panel</span>
                </a>

                <nav class="admin-nav" aria-label="Secciones del panel">
                    {secciones.map((s) =>
                        s.listo ? (
                            <a
                                href={s.href}
                                class:list={['admin-nav-item', { activo: s.id === seccion }]}
                                aria-current={s.id === seccion ? 'page' : undefined}
                            >
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icono} /></svg>
                                {s.label}
                            </a>
                        ) : (
                            <span class="admin-nav-item deshabilitado" title="Disponible en la siguiente etapa">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icono} /></svg>
                                {s.label}
                                <small>Pronto</small>
                            </span>
                        )
                    )}
                </nav>

                <a class="admin-ver-tienda" href="/">← Ver tienda</a>
            </aside>

            <main class="admin-main">
                <slot />
            </main>
        </div>
    </body>
</html>
