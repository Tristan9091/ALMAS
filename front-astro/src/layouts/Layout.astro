---
import "../styles/global.css";

import TopBar from "../components/layout/TopBar.astro";
import Footer from "../components/layout/Footer.astro";
import AsistenteIA from "../components/react/AsistenteIA.jsx";

const { title = "ALMĀS" } = Astro.props;

import { pwaInfo } from "virtual:pwa-info";
---

<!doctype html>

<html lang="es">
    <head>
        <meta charset="UTF-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#8f1268" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/icons/icon-192.png" />
        {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}

        <meta name="description" content="ALMĀS - Joyería" />

        <title>{title}</title>
    </head>

    <body>
        <TopBar />

        <slot />

        <Footer />

        <AsistenteIA client:load />
    </body>
</html>
