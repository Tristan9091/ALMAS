
---
import "../styles/global.css";

import TopBar from "../components/layout/TopBar.astro";
import Footer from "../components/layout/Footer.astro";
import AsistenteIA from "../components/react/AsistenteIA.jsx";
import EstadoConexion from "../components/react/EstadoConexion.jsx";

import { pwaInfo } from "virtual:pwa-info";
import { getAbsoluteLocaleUrl } from "astro:i18n";

import {
    obtenerIdioma,
    rutaLocalizada
} from "../i18n/utils";

const { title = "ALMĀS" } = Astro.props;

const idioma = obtenerIdioma(Astro.url.pathname);

const rutaBase = rutaLocalizada(
    Astro.url.pathname,
    "es"
).replace(/^\//, "");

const urlEs = getAbsoluteLocaleUrl("es", rutaBase);
const urlEn = getAbsoluteLocaleUrl("en", rutaBase);
---

<!doctype html>

<html lang={idioma}>

    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />

        <meta name="theme-color" content="#8f1268" />

        <link
            rel="icon"
            href="/favicon.svg"
            type="image/svg+xml"
        />

        <link
            rel="apple-touch-icon"
            href="/icons/icon-192.png"
        />

        {pwaInfo && (
            <Fragment set:html={pwaInfo.webManifest.linkTag} />
        )}

        <meta
            name="description"
            content={
                idioma === "es"
                    ? "ALMĀS - Joyería"
                    : "ALMĀS - Jewelry"
            }
        />

        <title>{title}</title>

        <link rel="alternate" hreflang="es" href={urlEs} />
        <link rel="alternate" hreflang="en" href={urlEn} />
        <link rel="alternate" hreflang="x-default" href={urlEs} />

        <script is:inline>
            window.addEventListener("beforeinstallprompt", (e) => {
                e.preventDefault();

                window.__pwaPrompt = e;

                window.dispatchEvent(
                    new Event("pwa-prompt-ready")
                );
            });

            window.addEventListener("appinstalled", () => {
                window.__pwaPrompt = null;

                window.dispatchEvent(
                    new Event("pwa-installed")
                );
            });
        </script>

    </head>

    <body>

        <TopBar />

        <EstadoConexion client:load idioma={idioma} />

        <slot />

        <Footer />

        <AsistenteIA client:load idioma={idioma} />

        <script>
            import { registerSW } from "virtual:pwa-register";

            registerSW({ immediate: true });
        </script>

    </body>

</html>
