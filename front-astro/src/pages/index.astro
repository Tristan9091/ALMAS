---
export const prerender = false

import Layout from '../layouts/Layout.astro'
import Hero from '../components/layout/Hero.astro'
import Sidebar from '../components/layout/Sidebar.astro'
import ProductCard from '../components/ProductCard.astro'

import { graphqlRequest } from '../graphql/client'

interface Categoria {
    id: number
    nombre: string
    imagenUrl?: string | null
}

interface Producto {
    id: number
    nombre: string
    precio: number
    imagenUrl?: string | null
    descripcion: string
}

interface HomeData {
    categorias: Categoria[]
    products: Producto[]
}

const QUERY_HOME = `
    query {
        categorias {
            id
            nombre
            imagenUrl
        }

        products {
            id
            nombre
            precio
            imagenUrl
            descripcion
        }
    }
`

let categorias: Categoria[] = []
let productos: Producto[] = []
let error: string | null = null

try {
    const data = await graphqlRequest<HomeData>(QUERY_HOME)

    categorias = data.categorias
    productos = data.products

} catch (err) {
    console.error(err)
    error = 'No se pudo cargar el catálogo.'
}


// BUSQUEDA Y FILTROS
const parametros = Astro.url.searchParams

const buscar = parametros.get('buscar')?.trim().toLowerCase() ?? ''

const precioMinimo = Number(parametros.get('min') ?? 0)
const precioMaximo = Number(parametros.get('max') ?? 0)

const ordenar = parametros.get('ordenar') ?? ''

const productosFiltrados = productos
    .filter((producto) => {
        const coincideBusqueda =
            !buscar ||
            producto.nombre.toLowerCase().includes(buscar) ||
            (producto.descripcion ?? '').toLowerCase().includes(buscar)

        const coincideMinimo =
            !Number.isFinite(precioMinimo) ||
            precioMinimo <= 0 ||
            producto.precio >= precioMinimo

        const coincideMaximo =
            !Number.isFinite(precioMaximo) ||
            precioMaximo <= 0 ||
            producto.precio <= precioMaximo

        return coincideBusqueda && coincideMinimo && coincideMaximo
    })
    .sort((a, b) => {
        if (ordenar === 'precio-asc') return a.precio - b.precio
        if (ordenar === 'precio-desc') return b.precio - a.precio
        return 0
    })
---

<Layout title="ALMĀS">

    <Hero />

    <div class="content">

        <Sidebar categorias={categorias} />

        <main>
            <h2>
                {
                    buscar
                    ? `Resultados para "${buscar}"`
                    : 'Catálogo'
                }
            </h2>
            <form method="GET" action="/" class="filtros-catalogo">

                <input
                    type="search"
                    name="buscar"
                    placeholder="Buscar joyas..."
                    value={Astro.url.searchParams.get('buscar') ?? ''}
                />

                <input
                    type="number"
                    name="min"
                    min="0"
                    step="0.01"
                    placeholder="Precio mínimo"
                    value={Astro.url.searchParams.get('min') ?? ''}
                />

                <input
                    type="number"
                    name="max"
                    min="0"
                    step="0.01"
                    placeholder="Precio máximo"
                    value={Astro.url.searchParams.get('max') ?? ''}
                />

                <select name="ordenar">
                    <option value="">Orden predeterminado</option>
                    <option value="precio-asc" selected={ordenar === 'precio-asc'}>
                        Menor precio
                    </option>
                    <option value="precio-desc" selected={ordenar === 'precio-desc'}>
                        Mayor precio
                    </option>
                </select>

                <button type="submit">Aplicar filtros</button>
                <a href="/">Limpiar</a>

            </form>

            {
                error ? (
                    <p class="error">
                        {error}
                    </p>
                ) : productosFiltrados.length === 0 ? (
                    <p>
                        No hay productos disponibles.
                    </p>
                ) : (
                    <div class="products">
                        {
                            productosFiltrados.map((producto) => (
                                <ProductCard
                                    id={producto.id}
                                    nombre={producto.nombre}
                                    precio={producto.precio}
                                    imagenUrl={producto.imagenUrl}
                                />
                            ))
                        }
                    </div>
                )
            }
        </main>

    </div>

</Layout>

<style>
    .content {
        display: flex;
    }

    main {
        flex: 1;
        min-height: 80vh;
        padding: 2rem;
    }

    h2 {
        font-family: var(--font-heading);
        color: var(--color-purple);
        margin-top: 0;
    }

    .products {
        display: grid;
        grid-template-columns:
            repeat(auto-fill, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .error {
        color: #a00;
    }
    .filtros-catalogo {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 2rem;
}

.filtros-catalogo input,
.filtros-catalogo select {
    min-width: 130px;
    flex: 1;
    padding: 0.75rem;
    border: 1px solid #d8c9b5;
    border-radius: 8px;
    background: white;
    color: #333;
}

.filtros-catalogo button {
    padding: 0.75rem 1.25rem;
    border: none;
    border-radius: 8px;
    background: var(--color-purple);
    color: white;
    cursor: pointer;
}

.filtros-catalogo a {
    color: var(--color-purple);
    text-decoration: none;
}

@media (max-width: 600px) {
    .filtros-catalogo {
        flex-direction: column;
        align-items: stretch;
    }
}
</style>