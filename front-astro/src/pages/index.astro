
---
export const prerender = false

import Layout from '../layouts/Layout.astro'
import Hero from '../components/layout/Hero.astro'
import Sidebar from '../components/layout/Sidebar.astro'
import ProductCard from '../components/ProductCard.astro'
import FiltrosCatalogo from '../components/FiltrosCatalogo.astro'

import { graphqlRequest } from '../graphql/client'

interface Categoria {
    id: number
    nombre: string
    imagenUrl?: string | null
}

interface Producto {
    id: number
    nombre: string
    precio: number
    imagenUrl?: string | null
    descripcion: string
}

interface HomeData {
    categorias: Categoria[]
    products: Producto[]
}

const QUERY_HOME = `
    query Catalogo(
        $buscar: String
        $precioMin: Float
        $precioMax: Float
        $material: String
        $piedra: String
        $color: String
        $disponible: Boolean
        $orden: String
    ) {
        categorias {
            id
            nombre
            imagenUrl
        }

        products(
            buscar: $buscar
            precioMin: $precioMin
            precioMax: $precioMax
            material: $material
            piedra: $piedra
            color: $color
            disponible: $disponible
            orden: $orden
            limit: 100
        ) {
            id
            nombre
            precio
            imagenUrl
            descripcion
        }
    }
`

// Obtener los filtros de la URL
const parametros = Astro.url.searchParams

const texto = (nombre: string): string =>
    parametros.get(nombre)?.trim() || ''

const numero = (nombre: string): number | null => {
    const valor = texto(nombre)

    if (!valor) return null

    const resultado = Number(valor)

    return Number.isFinite(resultado) && resultado >= 0
        ? resultado
        : null
}

// Filtros seleccionados
const buscar = texto('buscar')
const precioMin = numero('precioMin')
const precioMax = numero('precioMax')
const material = texto('material')
const piedra = texto('piedra')
const color = texto('color')
const orden = texto('orden')
const disponible = parametros.get('disponible') === 'true'

// Datos del catalogo
let categorias: Categoria[] = []
let productos: Producto[] = []
let error: string | null = null

// Consultar productos con los filtros aplicados
try {
    const data = await graphqlRequest<HomeData>(
        QUERY_HOME,
        {
            buscar: buscar || null,
            precioMin,
            precioMax,
            material: material || null,
            piedra: piedra || null,
            color: color || null,
            disponible: disponible ? true : null,
            orden: orden || null,
        }
    )

    categorias = data.categorias
    productos = data.products

} catch (err) {
    console.error('[Catalogo] Error:', err)
    error = 'No se pudo cargar el catálogo.'
}
---

<Layout title="ALMĀS">

    <Hero />

    <div class="content">

        <Sidebar categorias={categorias} />

        <main>

            <h2>
                {
                    buscar
                        ? `Resultados para "${buscar}"`
                        : 'Catálogo'
                }
            </h2>

            <!-- Componente compartido de filtros -->
            <FiltrosCatalogo parametros={parametros} />

            {
                error ? (

                    <p class="error">
                        {error}
                    </p>

                ) : productos.length === 0 ? (

                    <div class="sin-resultados">
                        <h3>No se encontraron productos</h3>

                        <p>
                            Intenta modificar los filtros
                            o realizar otra búsqueda.
                        </p>

                        <a href="/">
                            Ver todos los productos
                        </a>
                    </div>

                ) : (

                    <div class="products">

                        {
                            productos.map((producto) => (

                                <ProductCard
                                    id={producto.id}
                                    nombre={producto.nombre}
                                    precio={producto.precio}
                                    imagenUrl={producto.imagenUrl}
                                />

                            ))
                        }

                    </div>

                )
            }

        </main>

    </div>

</Layout>

<style>
    .content {
        display: flex;
    }

    main {
        flex: 1;
        min-width: 0;
        min-height: 80vh;
        padding: 2rem;
    }

    h2 {
        font-family: var(--font-heading);
        color: var(--color-purple);
        margin-top: 0;
    }

    .products {
        display: grid;
        grid-template-columns:
            repeat(auto-fill, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .error {
        color: #a00;
    }

    .sin-resultados {
        padding: 3rem 1.5rem;
        text-align: center;
        background: #fffaf6;
        border: 1px solid #eadbc8;
        border-radius: 16px;
    }

    .sin-resultados h3 {
        color: var(--color-purple);
        margin-top: 0;
    }

    .sin-resultados p {
        color: #777;
        margin-bottom: 1.5rem;
    }

    .sin-resultados a {
        display: inline-block;
        padding: 0.8rem 1.5rem;
        background: var(--color-purple);
        color: white;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
    }

    .sin-resultados a:hover {
        background: #741052;
    }

    @media (max-width: 600px) {
        .content {
            flex-direction: column;
        }

        main {
            padding: 1rem;
        }
    }
</style>
