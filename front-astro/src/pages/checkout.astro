
---
import Layout from "../layouts/Layout.astro";
import Checkout from "../components/react/Checkout.jsx";

import {
    obtenerIdioma,
    traducir
} from "../i18n/utils";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (es: string, en: string) => traducir(idioma, es, en);
---

<Layout title={t("Finalizar compra | ALMĀS", "Checkout | ALMĀS")}>

    <main>

        <h1>
            {t("Finalizar compra", "Checkout")}
        </h1>

        <Checkout client:load idioma={idioma} />

    </main>

</Layout>

<style>
    main {
        width: 100%;
        max-width: 1100px;

        min-height: 80vh;
        min-height: 80dvh;

        margin: 0 auto;
        padding: var(--page-padding);
    }

    h1 {
        font-family: var(--font-heading);
        color: var(--color-purple);
        font-size: 1.5rem;

        overflow-wrap: anywhere;
    }

    @media (min-width: 360px) {
        h1 {
            font-size: 1.75rem;
        }
    }

    @media (min-width: 768px) {
        h1 {
            font-size: 2rem;
        }
    }

    @media (min-width: 1200px) {
        h1 {
            font-size: 2.2rem;
        }
    }
</style>
