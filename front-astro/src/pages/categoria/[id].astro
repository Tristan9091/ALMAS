
---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Sidebar from "../../components/layout/Sidebar.astro";
import ProductCard from "../../components/ProductCard.astro";
import FiltrosCatalogo from "../../components/FiltrosCatalogo.astro";

import { graphqlRequest } from "../../graphql/client";

import {
    obtenerIdioma,
    rutaLocalizada,
    traducir
} from "../../i18n/utils";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (es: string, en: string) => traducir(idioma, es, en);

interface Categoria {
    id: number;
    nombre: string;
    imagenUrl?: string | null;
}

interface Producto {
    id: number;
    nombre: string;
    precio: number;
    imagenUrl?: string | null;
}

interface CatalogoData {
    categoria: Categoria | null;
    categorias: Categoria[];
    products: Producto[];
}

const QUERY_CATALOGO = `
    query CatalogoCategoria(
        $id: Int!
        $buscar: String
        $precioMin: Float
        $precioMax: Float
        $material: String
        $piedra: String
        $color: String
        $disponible: Boolean
        $orden: String
    ) {
        categoria(id: $id) {
            id
            nombre
        }

        categorias {
            id
            nombre
            imagenUrl
        }

        products(
            categoriaId: $id
            buscar: $buscar
            precioMin: $precioMin
            precioMax: $precioMax
            material: $material
            piedra: $piedra
            color: $color
            disponible: $disponible
            orden: $orden
            limit: 100
        ) {
            id
            nombre
            precio
            imagenUrl
        }
    }
`;

// Obtener la categoría seleccionada
const { id } = Astro.params;
const categoryId = Number(id);

const parametros = Astro.url.searchParams;

const texto = (nombre: string): string =>
    parametros.get(nombre)?.trim() || "";

const numero = (nombre: string): number | null => {
    const valor = texto(nombre);

    if (!valor) return null;

    const resultado = Number(valor);

    return Number.isFinite(resultado) && resultado >= 0
        ? resultado
        : null;
};

// Filtros seleccionados
const buscar = texto("buscar");
const precioMin = numero("precioMin");
const precioMax = numero("precioMax");
const material = texto("material");
const piedra = texto("piedra");
const color = texto("color");
const orden = texto("orden");
const disponible = parametros.get("disponible") === "true";

// Datos del catálogo
let categoria: Categoria | null = null;
let categorias: Categoria[] = [];
let productos: Producto[] = [];
let error: string | null = null;

try {
    const data = await graphqlRequest<CatalogoData>(
        QUERY_CATALOGO,
        {
            id: categoryId,
            buscar: buscar || null,
            precioMin,
            precioMax,
            material: material || null,
            piedra: piedra || null,
            color: color || null,
            disponible: disponible ? true : null,
            orden: orden || null,
        }
    );

    categoria = data.categoria;
    categorias = data.categorias;
    productos = data.products;

} catch (err) {
    console.error("[Categoria] Error:", err);

    error = t(
        "No se pudo cargar la categoría.",
        "Could not load the category."
    );
}
---

<Layout
    title={
        categoria
            ? `${categoria.nombre} | ALMĀS`
            : t("Categoría | ALMĀS", "Category | ALMĀS")
    }
>

    <div class="content">

        <Sidebar categorias={categorias} />

        <main>

            {
                error ? (

                    <p class="error">
                        {error}
                    </p>

                ) : !categoria ? (

                    <div class="sin-resultados">

                        <h2>
                            {
                                t(
                                    "Categoría no encontrada",
                                    "Category not found"
                                )
                            }
                        </h2>

                        <p>
                            {
                                t(
                                    "La categoría que buscas no está disponible.",
                                    "The category you are looking for is unavailable."
                                )
                            }
                        </p>

                        <a href={rutaLocalizada("/", idioma)}>
                            {
                                t(
                                    "Volver al catálogo",
                                    "Back to catalog"
                                )
                            }
                        </a>

                    </div>

                ) : (

                    <>
                        <h1>{categoria.nombre}</h1>

                        <FiltrosCatalogo
                            categoriaId={categoryId}
                            parametros={parametros}
                        />

                        <p class="resultados">
                            {
                                productos.length === 1
                                    ? t(
                                        "1 producto encontrado",
                                        "1 product found"
                                    )
                                    : t(
                                        `${productos.length} productos encontrados`,
                                        `${productos.length} products found`
                                    )
                            }
                        </p>

                        {
                            productos.length === 0 ? (

                                <div class="sin-resultados">

                                    <h2>
                                        {
                                            t(
                                                "Sin resultados",
                                                "No results"
                                            )
                                        }
                                    </h2>

                                    <p>
                                        {
                                            t(
                                                "No encontramos productos que coincidan con los filtros seleccionados.",
                                                "No products match the selected filters."
                                            )
                                        }
                                    </p>

                                    <a
                                        href={
                                            rutaLocalizada(
                                                `/categoria/${categoryId}`,
                                                idioma
                                            )
                                        }
                                    >
                                        {
                                            t(
                                                "Limpiar filtros",
                                                "Clear filters"
                                            )
                                        }
                                    </a>

                                </div>

                            ) : (

                                <div class="products">

                                    {
                                        productos.map((producto) => (

                                            <ProductCard
                                                id={producto.id}
                                                nombre={producto.nombre}
                                                precio={producto.precio}
                                                imagenUrl={producto.imagenUrl}
                                            />

                                        ))
                                    }

                                </div>

                            )
                        }
                    </>

                )
            }

        </main>

    </div>

</Layout>

<style>
    .content {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: var(--content-max-width);
        margin-inline: auto;
    }

    main {
        flex: 1;
        width: 100%;
        min-width: 0;
        min-height: 80dvh;
        padding: var(--page-padding);
    }

    h1 {
        font-family: var(--font-heading);
        color: var(--color-purple);
        margin: 0 0 1.5rem;
        overflow-wrap: anywhere;
    }

    .resultados {
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        color: #777;
    }

    .products {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
    }

    .sin-resultados {
        padding: 2rem 1rem;
        text-align: center;
        background: #fffaf6;
        border: 1px solid #eadbc8;
        border-radius: 16px;
        overflow-wrap: anywhere;
    }

    .sin-resultados h2 {
        color: var(--color-purple);
        margin-top: 0;
    }

    .sin-resultados p {
        color: #777;
        margin-bottom: 1.5rem;
    }

    .sin-resultados a {
        display: inline-block;
        padding: 0.8rem 1.5rem;
        background: var(--color-purple);
        color: white;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        max-width: 100%;
    }

    .sin-resultados a:hover {
        background: #741052;
    }

    .error {
        color: #a00;
    }

    @media (min-width: 360px) {
        .products {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 768px) {
        .content {
            flex-direction: row;
        }

        .products {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }

        .sin-resultados {
            padding: 3rem 1.5rem;
        }
    }

    @media (min-width: 1200px) {
        .products {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 24px;
        }
    }
</style>
