
---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../components/layout/Sidebar.astro'
import ProductCard from '../../components/ProductCard.astro'
import FiltrosCatalogo from '../../components/FiltrosCatalogo.astro'

import { graphqlRequest } from '../../graphql/client'

interface Categoria {
    id: number
    nombre: string
    imagenUrl?: string | null
}

interface Producto {
    id: number
    nombre: string
    precio: number
    imagenUrl?: string | null
}

interface CatalogoData {
    categoria: Categoria | null
    categorias: Categoria[]
    products: Producto[]
}

const QUERY_CATALOGO = `
    query CatalogoCategoria(
        $id: Int!
        $buscar: String
        $precioMin: Float
        $precioMax: Float
        $material: String
        $piedra: String
        $color: String
        $disponible: Boolean
        $orden: String
    ) {
        categoria(id: $id) {
            id
            nombre
        }

        categorias {
            id
            nombre
            imagenUrl
        }

        products(
            categoriaId: $id
            buscar: $buscar
            precioMin: $precioMin
            precioMax: $precioMax
            material: $material
            piedra: $piedra
            color: $color
            disponible: $disponible
            orden: $orden
            limit: 100
        ) {
            id
            nombre
            precio
            imagenUrl
        }
    }
`

// Obtener la categoria seleccionada
const { id } = Astro.params
const categoryId = Number(id)

// Obtener los filtros de la URL
const parametros = Astro.url.searchParams

const texto = (nombre: string): string =>
    parametros.get(nombre)?.trim() || ''

const numero = (nombre: string): number | null => {
    const valor = texto(nombre)

    if (!valor) return null

    const resultado = Number(valor)

    return Number.isFinite(resultado) && resultado >= 0
        ? resultado
        : null
}

// Filtros seleccionados
const buscar = texto('buscar')
const precioMin = numero('precioMin')
const precioMax = numero('precioMax')
const material = texto('material')
const piedra = texto('piedra')
const color = texto('color')
const orden = texto('orden')
const disponible = parametros.get('disponible') === 'true'

// Datos del catalogo
let categoria: Categoria | null = null
let categorias: Categoria[] = []
let productos: Producto[] = []
let error: string | null = null

// Consultar los productos de la categoria
try {
    const data = await graphqlRequest<CatalogoData>(
        QUERY_CATALOGO,
        {
            id: categoryId,
            buscar: buscar || null,
            precioMin,
            precioMax,
            material: material || null,
            piedra: piedra || null,
            color: color || null,
            disponible: disponible ? true : null,
            orden: orden || null,
        }
    )

    categoria = data.categoria
    categorias = data.categorias
    productos = data.products

} catch (err) {
    console.error('[Categoria] Error:', err)
    error = 'No se pudo cargar la categoría.'
}
---

<Layout
    title={
        categoria
            ? `${categoria.nombre} | ALMĀS`
            : 'Categoría | ALMĀS'
    }
>

    <div class="content">

        <Sidebar categorias={categorias} />

        <main>

            {
                error ? (

                    <p class="error">
                        {error}
                    </p>

                ) : !categoria ? (

                    <div class="sin-resultados">
                        <h2>Categoría no encontrada</h2>

                        <p>
                            La categoría que buscas no está disponible.
                        </p>

                        <a href="/">
                            Volver al catálogo
                        </a>
                    </div>

                ) : (

                    <>
                        <h1>{categoria.nombre}</h1>

                        <!-- Filtros compartidos con el catalogo general -->
                        <FiltrosCatalogo
                            categoriaId={categoryId}
                            parametros={parametros}
                        />

                        <p class="resultados">
                            {
                                productos.length === 1
                                    ? '1 producto encontrado'
                                    : `${productos.length} productos encontrados`
                            }
                        </p>

                        {
                            productos.length === 0 ? (

                                <div class="sin-resultados">
                                    <h2>Sin resultados</h2>

                                    <p>
                                        No encontramos productos que coincidan
                                        con los filtros seleccionados.
                                    </p>

                                    <a href={`/categoria/${categoryId}`}>
                                        Limpiar filtros
                                    </a>
                                </div>

                            ) : (

                                <div class="products">

                                    {
                                        productos.map((producto) => (

                                            <ProductCard
                                                id={producto.id}
                                                nombre={producto.nombre}
                                                precio={producto.precio}
                                                imagenUrl={producto.imagenUrl}
                                            />

                                        ))
                                    }

                                </div>

                            )
                        }
                    </>

                )
            }

        </main>

    </div>

</Layout>

<style>
    .content {
        display: flex;
    }

    main {
        flex: 1;
        min-width: 0;
        min-height: 80vh;
        padding: 2rem;
    }

    h1 {
        font-family: var(--font-heading);
        color: var(--color-purple);
        margin: 0 0 1.5rem;
    }

    .resultados {
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        color: #777;
    }

    .products {
        display: grid;
        grid-template-columns:
            repeat(auto-fill, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .sin-resultados {
        padding: 3rem 1.5rem;
        text-align: center;
        background: #fffaf6;
        border: 1px solid #eadbc8;
        border-radius: 16px;
    }

    .sin-resultados h2 {
        color: var(--color-purple);
        margin-top: 0;
    }

    .sin-resultados p {
        color: #777;
        margin-bottom: 1.5rem;
    }

    .sin-resultados a {
        display: inline-block;
        padding: 0.8rem 1.5rem;
        background: var(--color-purple);
        color: white;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
    }

    .sin-resultados a:hover {
        background: #741052;
    }

    .error {
        color: #a00;
    }

    @media (max-width: 600px) {
        .content {
            flex-direction: column;
        }

        main {
            padding: 1rem;
        }
    }
</style>
