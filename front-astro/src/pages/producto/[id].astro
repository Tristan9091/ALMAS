
---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Sidebar from "../../components/layout/Sidebar.astro";
import AddToCart from "../../components/react/AddToCart.jsx";

import { graphqlRequest } from "../../graphql/client";

import {
    obtenerIdioma,
    traducir
} from "../../i18n/utils";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (es: string, en: string) => traducir(idioma, es, en);

interface Categoria {
    id: number;
    nombre: string;
    imagenUrl?: string | null;
}

interface Variante {
    id: number;
    tipo: string;
    valor: string;
}

interface Producto {
    id: number;
    nombre: string;
    descripcion?: string | null;
    precio: number;
    imagenUrl?: string | null;
    stock: number;
    variantes: Variante[];
}

interface ProductoData {
    product: Producto | null;
    categorias: Categoria[];
}

const QUERY_PRODUCTO = `
    query Producto($id: Int!) {

        product(id: $id) {
            id
            nombre
            descripcion
            precio
            imagenUrl
            stock

            variantes {
                id
                tipo
                valor
            }
        }

        categorias {
            id
            nombre
            imagenUrl
        }
    }
`;

const { id } = Astro.params;
const productId = Number(id);

let producto: Producto | null = null;
let categorias: Categoria[] = [];
let error: string | null = null;

try {

    const data = await graphqlRequest<ProductoData>(
        QUERY_PRODUCTO,
        {
            id: productId
        }
    );

    producto = data.product;
    categorias = data.categorias;

} catch (err) {

    console.error(err);

    error = t(
        "No se pudo cargar el producto.",
        "Could not load the product."
    );

}

const formatearPrecio = (precio: number) =>
    new Intl.NumberFormat(
        idioma === "en" ? "en-US" : "es-MX",
        {
            style: "currency",
            currency: "MXN",
            currencyDisplay: "code"
        }
    ).format(precio);
---

<Layout
    title={
        producto
            ? `${producto.nombre} | ALMĀS`
            : t("Producto | ALMĀS", "Product | ALMĀS")
    }
>

    <div class="content">

        <Sidebar categorias={categorias} />

        <main>

            {
                error ? (

                    <p class="error">
                        {error}
                    </p>

                ) : !producto ? (

                    <p>
                        {
                            t(
                                "Producto no encontrado.",
                                "Product not found."
                            )
                        }
                    </p>

                ) : (

                    <div class="product">

                        <div class="image-container">

                            <img
                                src={
                                    producto.imagenUrl ||
                                    "https://placehold.co/600x600?text=ALMAS"
                                }
                                alt={producto.nombre}
                            />

                        </div>

                        <div class="info">

                            <h1>{producto.nombre}</h1>

                            <p class="description">
                                {producto.descripcion}
                            </p>

                            <p class="price">
                                {formatearPrecio(producto.precio)}
                            </p>

                            <p>
                                {
                                    t(
                                        "Stock disponible:",
                                        "Available stock:"
                                    )
                                } {producto.stock}
                            </p>

                            {
                                producto.variantes.length > 0 && (

                                    <div class="variants">

                                        <h2>
                                            {
                                                t(
                                                    "Variantes",
                                                    "Variants"
                                                )
                                            }
                                        </h2>

                                        {
                                            producto.variantes.map(
                                                (variante) => (

                                                    <div class="variant">

                                                        <strong>
                                                            {variante.tipo}:
                                                        </strong>

                                                        {" "}

                                                        {variante.valor}

                                                    </div>

                                                )
                                            )
                                        }

                                    </div>

                                )
                            }

                            <AddToCart
                                client:load
                                idioma={idioma}
                                producto={{
                                    id: producto.id,
                                    nombre: producto.nombre,
                                    precio: producto.precio,
                                    imagenUrl: producto.imagenUrl,
                                    stock: producto.stock,
                                    variantes: producto.variantes
                                }}
                            />

                        </div>

                    </div>

                )
            }

        </main>

    </div>

</Layout>

<style>
    .content {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: var(--content-max-width);
        margin-inline: auto;
    }

    main {
        flex: 1;
        width: 100%;
        min-width: 0;
        min-height: 80dvh;
        padding: var(--page-padding);
    }

    .product {
        max-width: 1000px;
        margin: 0 auto;

        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.5rem;
    }

    .info,
    .image-container {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .image-container img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 16px;
        object-fit: cover;
    }

    h1 {
        margin-top: 0;
        font-family: var(--font-heading);
        color: var(--color-purple);
        font-size: 1.6rem;
    }

    .description {
        line-height: 1.6;
    }

    .price {
        font-size: 1.5rem;
        font-weight: bold;
        color: var(--color-purple);
    }

    .variants {
        margin: 1.5rem 0;
    }

    .variants h2 {
        font-size: 1.1rem;
        color: var(--color-purple);
    }

    .variant {
        margin: 0.5rem 0;
    }

    .error {
        color: #a00;
    }

    @media (min-width: 360px) {
        .product {
            gap: 2rem;
        }
    }

    @media (min-width: 768px) {
        .content {
            flex-direction: row;
        }

        .product {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            align-items: start;
        }

        h1 {
            font-size: 2rem;
        }

        .price {
            font-size: 1.6rem;
        }
    }

    @media (min-width: 1200px) {
        .product {
            gap: 3rem;
        }
    }
</style>
