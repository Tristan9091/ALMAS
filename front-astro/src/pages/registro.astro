
---
import Layout from "../layouts/Layout.astro";
import RegisterForm from "../components/react/RegisterForm.jsx";

import {
    obtenerIdioma,
    traducir
} from "../i18n/utils";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (es: string, en: string) => traducir(idioma, es, en);
---

<Layout title={t("Crear cuenta | ALMĀS", "Create account | ALMĀS")}>

    <main class="auth-page">

        <RegisterForm client:load idioma={idioma} />

    </main>

</Layout>
