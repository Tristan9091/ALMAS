
---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/react/LoginForm.jsx";

import {
    obtenerIdioma,
    traducir
} from "../i18n/utils";

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (es: string, en: string) => traducir(idioma, es, en);
---

<Layout title={t("Iniciar sesión | ALMĀS", "Sign in | ALMĀS")}>

    <main class="auth-page">

        <LoginForm client:load idioma={idioma} />

    </main>

</Layout>
