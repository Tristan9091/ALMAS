
---
import { obtenerIdioma, traducir } from "../../i18n/utils";

const idioma = obtenerIdioma(Astro.url.pathname);
---

<section class="hero">
    <h1>ALMĀS</h1>

    <p class="hero-logo">
        aljawahiriu
    </p>

    <p class="hero-phrase">
        {
            traducir(
                idioma,
                "No puedes comprar la felicidad, pero puedes comprar joyas y eso se acerca bastante.",
                "You can't buy happiness but you can buy jewellery and that's pretty close."
            )
        }
    </p>
</section>

<style>
    .hero {
        position: relative;
        width: 100%;

        min-height: 65vh;
        min-height: 65dvh;

        padding: 24px var(--page-padding);

        background-image:
            linear-gradient(
                rgba(143, 18, 104, 0.55),
                rgba(143, 18, 104, 0.75)
            ),
            url("https://st.depositphotos.com/3006519/4596/i/450/depositphotos_45960435-stock-photo-gold-jewelry.jpg");

        background-size: cover;
        background-position: center;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        text-align: center;
        color: var(--color-text);
    }

    h1 {
        font-family: var(--font-heading);
        font-size: 2.8rem;
        margin: 0;
        letter-spacing: 2px;
        color: #fff;
    }

    .hero-logo {
        font-family: var(--font-script);
        color: var(--color-accent);
        font-size: 1.6rem;
        margin: 0.25rem 0;
    }

    .hero-phrase {
        font-style: italic;
        max-width: 500px;
        opacity: 0.9;
        color: #fff;
    }

    @media (min-width: 360px) {
        h1 {
            font-size: 3.2rem;
        }
    }

    @media (min-width: 768px) {
        .hero {
            min-height: 80dvh;
        }

        h1 {
            font-size: 4rem;
        }

        .hero-logo {
            font-size: 2rem;
        }
    }

    @media (min-width: 1200px) {
        .hero {
            min-height: 100dvh;
        }

        h1 {
            font-size: 5rem;
        }
    }

    @media (orientation: landscape) and (max-height: 500px) {
        .hero {
            min-height: 100dvh;
        }

        h1 {
            font-size: 2.8rem;
        }
    }
</style>
