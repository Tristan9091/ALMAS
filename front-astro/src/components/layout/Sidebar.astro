
---
import {
    obtenerIdioma,
    rutaLocalizada,
    traducir
} from "../../i18n/utils";

interface Categoria {
    id: number;
    nombre: string;
    imagenUrl?: string | null;
}

interface Props {
    categorias?: Categoria[];
}

const { categorias = [] } = Astro.props;
const idioma = obtenerIdioma(Astro.url.pathname);
---

<aside>
    <a class="home-button" href={rutaLocalizada("/", idioma)}>
        {traducir(idioma, "Inicio", "Home")}
    </a>

    {
        categorias.map((cat) => (
            <a
                class="category"
                href={rutaLocalizada(`/categoria/${cat.id}`, idioma)}
            >
                <img
                    src={
                        cat.imagenUrl ||
                        `https://placehold.co/80x80/c9a24b/8f1268?text=${cat.nombre[0]}`
                    }
                    alt={cat.nombre}
                />

                <span>{cat.nombre}</span>
            </a>
        ))
    }
</aside>

<style>
    aside {
        width: 100%;
        padding: 12px;

        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    .home-button {
        border: 1.5px solid var(--color-gold);
        color: var(--color-purple);

        font-size: 0.75rem;
        padding: 0.4rem 0.9rem;

        border-radius: 999px;
        text-decoration: none;
    }

    .category {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
        text-align: center;
        max-width: 100px;
    }

    .category img {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(253, 240, 220, 0.4);
    }

    .category span {
        font-size: 0.75rem;
        color: var(--color-text);
        overflow-wrap: anywhere;
    }

    @media (min-width: 360px) {
        .category img {
            width: 56px;
            height: 56px;
        }
    }

    @media (min-width: 768px) {
        aside {
            width: 110px;
            flex-shrink: 0;
            flex-direction: column;
            justify-content: flex-start;
            padding: 1.5rem 0.5rem;
            gap: 1.5rem;
        }

        .category img {
            width: 64px;
            height: 64px;
        }
    }

    @media (min-width: 1200px) {
        aside {
            width: 130px;
        }
    }
</style>
