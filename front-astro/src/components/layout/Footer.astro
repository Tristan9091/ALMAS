
---
import { obtenerIdioma, traducir } from "../../i18n/utils";

const year = new Date().getFullYear();
const idioma = obtenerIdioma(Astro.url.pathname);
---

<footer>
    © {year} ALMĀS
    {traducir(idioma, "joyería artesanal", "handcrafted jewelry")}
</footer>

<style>
    footer {
        text-align: center;
        padding: 1rem;
        color: var(--color-text);
        opacity: 0.7;
        font-size: 0.85rem;
    }
</style>
