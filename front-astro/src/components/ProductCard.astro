
---
import {
    obtenerIdioma,
    rutaLocalizada
} from "../i18n/utils";

interface Props {
    id: number;
    nombre: string;
    precio: number;
    imagenUrl?: string | null;
}

const { id, nombre, precio, imagenUrl } = Astro.props;

const idioma = obtenerIdioma(Astro.url.pathname);

const precioFormateado = new Intl.NumberFormat(
    idioma === "en" ? "en-US" : "es-MX",
    {
        style: "currency",
        currency: "MXN",
        currencyDisplay: "code"
    }
).format(precio);
---

<a
    class="product-card"
    href={rutaLocalizada(`/producto/${id}`, idioma)}
>
    <img
        src={
            imagenUrl ||
            "https://placehold.co/400x400?text=ALMAS"
        }
        alt={nombre}
    />

    <div class="product-info">
        <h3>{nombre}</h3>

        <p>{precioFormateado}</p>
    </div>
</a>

<style>
    .product-card {
        display: block;
        min-width: 0;

        text-decoration: none;
        color: inherit;

        border-radius: 12px;
        overflow: hidden;

        border: 1px solid rgba(201, 162, 75, 0.3);

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    }

    img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        display: block;
    }

    .product-info {
        padding: 0.75rem;
    }

    h3 {
        margin: 0 0 0.5rem;
        font-size: 0.9rem;
        overflow-wrap: anywhere;
    }

    p {
        margin: 0;
        color: var(--color-purple);
        font-weight: bold;
        overflow-wrap: anywhere;
    }

    @media (min-width: 768px) {
        .product-info {
            padding: 1rem;
        }

        h3 {
            font-size: 1.1rem;
        }
    }
</style>
