
---
import {
    obtenerIdioma,
    rutaLocalizada,
    traducir
} from "../i18n/utils";

interface Props {
    categoriaId?: number;
    parametros: URLSearchParams;
}

const { categoriaId, parametros } = Astro.props;

const idioma = obtenerIdioma(Astro.url.pathname);
const t = (es: string, en: string) => traducir(idioma, es, en);

const ruta = rutaLocalizada(
    categoriaId !== undefined
        ? `/categoria/${categoriaId}`
        : "/",
    idioma
);

const valor = (nombre: string) =>
    parametros.get(nombre) ?? "";

const orden = valor("orden");
const disponible = valor("disponible") === "true";
---

<form method="GET" action={ruta} class="filtros-catalogo">

    <div class="filtro-campo filtro-busqueda">

        <label for="filtro-buscar">
            {t("Buscar productos", "Search products")}
        </label>

        <div class="filtro-control">

            <input
                id="filtro-buscar"
                type="search"
                name="buscar"
                placeholder={
                    t(
                        "Nombre o descripción...",
                        "Name or description..."
                    )
                }
                value={valor("buscar")}
            />

        </div>

    </div>

    <div class="filtro-campo filtro-precio">

        <label for="filtro-min">
            {t("Precio mínimo", "Minimum price")}
        </label>

        <div class="filtro-control con-moneda">

            <span class="simbolo-moneda">$</span>

            <input
                id="filtro-min"
                type="number"
                name="precioMin"
                min="0"
                step="0.01"
                placeholder={t("Desde", "From")}
                value={valor("precioMin")}
            />

        </div>

    </div>

    <div class="filtro-campo filtro-precio">

        <label for="filtro-max">
            {t("Precio máximo", "Maximum price")}
        </label>

        <div class="filtro-control con-moneda">

            <span class="simbolo-moneda">$</span>

            <input
                id="filtro-max"
                type="number"
                name="precioMax"
                min="0"
                step="0.01"
                placeholder={t("Hasta", "To")}
                value={valor("precioMax")}
            />

        </div>

    </div>

    <div class="filtro-campo filtro-atributo">

        <label for="filtro-material">
            {t("Material", "Material")}
        </label>

        <div class="filtro-control">

            <input
                id="filtro-material"
                type="text"
                name="material"
                placeholder={t("Ej. Oro", "E.g. Oro")}
                value={valor("material")}
            />

        </div>

    </div>

    <div class="filtro-campo filtro-atributo">

        <label for="filtro-piedra">
            {t("Piedra", "Gemstone")}
        </label>

        <div class="filtro-control">

            <input
                id="filtro-piedra"
                type="text"
                name="piedra"
                placeholder={t("Ej. Diamante", "E.g. Diamante")}
                value={valor("piedra")}
            />

        </div>

    </div>

    <div class="filtro-campo filtro-atributo">

        <label for="filtro-color">
            {t("Color", "Color")}
        </label>

        <div class="filtro-control">

            <input
                id="filtro-color"
                type="text"
                name="color"
                placeholder={t("Ej. Dorado", "E.g. Dorado")}
                value={valor("color")}
            />

        </div>

    </div>

    <div class="filtro-campo filtro-orden">

        <label for="filtro-orden">
            {t("Ordenar productos", "Sort products")}
        </label>

        <div class="filtro-control">

            <select id="filtro-orden" name="orden">

                <option value="">
                    {t("Predeterminado", "Default")}
                </option>

                <option
                    value="precio_asc"
                    selected={orden === "precio_asc"}
                >
                    {t("Menor precio", "Lowest price")}
                </option>

                <option
                    value="precio_desc"
                    selected={orden === "precio_desc"}
                >
                    {t("Mayor precio", "Highest price")}
                </option>

                <option
                    value="nombre_asc"
                    selected={orden === "nombre_asc"}
                >
                    {t("Nombre A-Z", "Name A-Z")}
                </option>

                <option
                    value="nombre_desc"
                    selected={orden === "nombre_desc"}
                >
                    {t("Nombre Z-A", "Name Z-A")}
                </option>

                <option
                    value="recientes"
                    selected={orden === "recientes"}
                >
                    {t("Más recientes", "Newest")}
                </option>

            </select>

        </div>

    </div>

    {
        idioma === "en" && (
            <p class="aviso-filtros">
                Catalog data is currently stored in Spanish.
                Use Spanish terms when searching by name,
                material, gemstone or color.
            </p>
        )
    }

    <label class="filtro-disponible">

        <input
            type="checkbox"
            name="disponible"
            value="true"
            checked={disponible}
        />

        {t("Solo disponibles", "In stock only")}

    </label>

    <div class="filtro-acciones">

        <button type="submit" class="boton-aplicar">
            {t("Aplicar filtros", "Apply filters")}
        </button>

        <a href={ruta} class="boton-limpiar">
            {t("Limpiar", "Clear")}
        </a>

    </div>

</form>

<style>
    .filtros-catalogo {
        display: flex;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 0.85rem;

        width: 100%;
        min-width: 0;

        margin: 1.5rem 0 2rem;
        padding: 1rem;

        background: #fffaf6;
        border: 1px solid #eadbc8;
        border-radius: 16px;
    }

    .filtro-campo {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
        flex: 1 1 100%;
    }

    .filtro-campo label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-purple);
        overflow-wrap: anywhere;
    }

    .filtro-control {
        display: flex;
        align-items: center;
        min-width: 0;
        height: 44px;

        background: #ffffff;
        border: 1px solid #dcc9b4;
        border-radius: 10px;
        overflow: hidden;

        transition:
            border-color 0.2s,
            box-shadow 0.2s;
    }

    .filtro-control:focus-within {
        border-color: #94146c;
        box-shadow: 0 0 0 3px rgba(148, 20, 108, 0.1);
    }

    .filtro-control input,
    .filtro-control select {
        width: 100%;
        min-width: 0;
        height: 100%;
        padding: 0 0.85rem;

        border: none;
        outline: none;
        background: transparent;

        color: #43223d;
        font-family: inherit;
        font-size: 1rem;
    }

    .filtro-control input::placeholder {
        color: #9a8b98;
        opacity: 1;
    }

    .filtro-control select {
        cursor: pointer;
    }

    .simbolo-moneda {
        padding-left: 0.85rem;
        color: #a47b35;
        font-weight: 600;
        flex-shrink: 0;
    }

    .con-moneda input {
        padding-left: 0.4rem;
    }

    .filtro-control input[type="number"] {
        appearance: textfield;
        -moz-appearance: textfield;
    }

    .filtro-control input[type="number"]::-webkit-inner-spin-button,
    .filtro-control input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .filtro-disponible {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 44px;

        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-purple);

        cursor: pointer;
    }

    .filtro-disponible input {
        accent-color: var(--color-purple);
        width: 17px;
        height: 17px;
        flex-shrink: 0;
    }

    .filtro-acciones {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;

        width: 100%;
        min-width: 0;
        min-height: 44px;
    }

    .boton-aplicar {
        flex: 1;
        min-height: 44px;
        padding: 0.7rem 1.1rem;

        border: none;
        border-radius: 10px;

        background: var(--color-purple);
        color: #ffffff;

        font-family: inherit;
        font-weight: 600;

        cursor: pointer;

        transition:
            background 0.2s,
            transform 0.2s;
    }

    .boton-aplicar:hover {
        background: #741052;
        transform: translateY(-1px);
    }

    .boton-limpiar {
        color: var(--color-purple);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        padding-block: 8px;
    }

    .boton-limpiar:hover {
        text-decoration: underline;
    }

    .boton-aplicar:focus-visible,
    .boton-limpiar:focus-visible {
        outline: 2px solid var(--color-purple);
        outline-offset: 3px;
    }

    .aviso-filtros {
        width: 100%;
        margin: 0;
        color: #66515f;
        font-size: 0.8rem;
        line-height: 1.5;
    }

    @media (min-width: 360px) {

        .filtro-precio,
        .filtro-atributo {
            flex: 1 1 calc(50% - 0.5rem);
        }

    }

    @media (min-width: 768px) {

        .filtros-catalogo {
            padding: 1.25rem;
            gap: 1rem;
        }

        .filtro-busqueda {
            flex: 1.5 1 190px;
        }

        .filtro-precio {
            flex: 1 1 125px;
        }

        .filtro-atributo {
            flex: 1 1 145px;
        }

        .filtro-orden {
            flex: 1.2 1 160px;
        }

        .filtro-acciones {
            width: auto;
        }

        .boton-aplicar {
            flex: initial;
        }

    }

    @media (min-width: 1200px) {

        .filtros-catalogo {
            padding: 1.5rem;
        }

        .filtro-control input,
        .filtro-control select {
            font-size: 0.9rem;
        }

    }
</style>
